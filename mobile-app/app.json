{
  "expo": {
    "name": "PESA Work Tracking",
    "slug": "pesa-work-tracking",
    "version": "1.0.1",
    "jsEngine": "hermes",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zpchandrapur.pesaworktracking",
      "infoPlist": {
        "NSCameraUsageDescription": "PESA needs access to your camera to take inspection photos.",
        "NSPhotoLibraryUsageDescription": "PESA needs access to your photo library to select inspection photos.",
        "NSLocationWhenInUseUsageDescription": "PESA needs access to your location to record inspection locations.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "PESA needs access to your location to record inspection locations.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.zpchandrapur.pesaworktracking",
      "versionCode": 7,
      "targetSdkVersion": 35,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAjFLdphP7tlo99o3L6IgxbeSOHPsla9-Y"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withHermesEnabled",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PESA to access your camera to take inspection photos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow PESA to use your location for inspection tracking."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d9219131-2e25-4f2d-96a9-db10bbd550e9"
      }
    }
  }
}
